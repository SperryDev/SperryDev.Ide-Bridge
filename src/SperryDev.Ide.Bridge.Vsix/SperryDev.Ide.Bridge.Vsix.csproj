<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>SperryDev.Ide.Bridge.Vsix</RootNamespace>
    <AssemblyName>SperryDev.Ide.Bridge.Vsix</AssemblyName>
    <TargetName>SperryDev.Ide.Bridge.Vsix</TargetName>
    <ProjectTypeGuids>{82b43b9b-a64c-4715-b499-d71e9ca2bd60};{349c5851-65df-11da-9384-00065b846f21};{FAE04EC0-301F-11D3-BF4B-00C04F79EFBC}</ProjectTypeGuids>
    <GeneratePkgDefFile>true</GeneratePkgDefFile>
    <CreatePkgDefAssemblyToProcess>$(MSBuildProjectDirectory)\bin\$(Configuration)\$(TargetFramework)\$(AssemblyName).dll</CreatePkgDefAssemblyToProcess>
    <UseCodebase>true</UseCodebase>
    <IncludeAssemblyInVSIXContainer>true</IncludeAssemblyInVSIXContainer>
    <IncludeDebugSymbolsInVSIXContainer>true</IncludeDebugSymbolsInVSIXContainer>
    <IncludeCopyLocalReferencesInVSIXContainer>true</IncludeCopyLocalReferencesInVSIXContainer>
    <CopyBuildOutputToOutputDirectory>true</CopyBuildOutputToOutputDirectory>
    <CopyOutputSymbolsToOutputDirectory>true</CopyOutputSymbolsToOutputDirectory>
    <CreateVsixContainer>true</CreateVsixContainer>
    <DeployExtension>false</DeployExtension>
    <DeployVSTemplates>false</DeployVSTemplates>
    <TemplateOutputDirectory>$(MSBuildProjectDirectory)\obj\Templates\</TemplateOutputDirectory>
    <DeployVSTestDependencies>false</DeployVSTestDependencies>
    <VSSDKTargetPlatformRegRoot>HKCU\Software\Microsoft\VisualStudio\18.0</VSSDKTargetPlatformRegRoot>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.VSSDK.BuildTools" Version="18.11.1036" />
    <PackageReference Include="Microsoft.VisualStudio.SDK" Version="18.11.1036" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SperryDev.Ide.Bridge\SperryDev.Ide.Bridge.csproj" SetTargetFramework="TargetFramework=net48" />
  </ItemGroup>

  <ItemGroup>
    <VSCTCompile Include="VSCommandTable.vsct">
      <ResourceName>Menus.ctmenu</ResourceName>
    </VSCTCompile>
  </ItemGroup>

  <PropertyGroup>
    <VsSdkTargetsPath Condition="'$(VsSdkTargetsPath)' == ''">$(ProgramW6432)\Microsoft Visual Studio\18\Community\MSBuild\Microsoft\VisualStudio\v18.0\VSSDK\Microsoft.VsSDK.targets</VsSdkTargetsPath>
  </PropertyGroup>
  <Import Project="$(VsSdkTargetsPath)" Condition="Exists('$(VsSdkTargetsPath)')" />

  <ItemGroup>
    <Content Include="source.extension.vsixmanifest">
      <SubType>Designer</SubType>
    </Content>
  </ItemGroup>

</Project>
